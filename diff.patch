new file mode 100644
index 0000000..9c391a7
--- /dev/null
+++ b/input/test_env/nwdiag_test_env.puml
@@ -0,0 +1,38 @@
+@startnwdiag test_env
+' Specify diagram name above, otherwise falls back on filename for output directory
+' Note: this name must match with that of the deployment diagram
+
+' Network definition
+'
+' Format: network <network_name> { ... }
+network alpha {
+  ' Subnet definition
+  '
+  ' Format: address = <network-address>/<prefix-length>
+  address = "172.26.0.0/24"
+
+  ' Host definition
+  '
+  ' Notes:
+  ' - By default the <description> attribute will be used as the resulting hostname;
+  '   <host_identifier> is the fallback if <description> is unused.
+  ' - Underscores in the hostname will be converted to hyphens, due to Unix conventions
+  '
+  ' Format: <host_identifier> [description = <description> address = <ipv4_address>, cpus = <amt_cores>, memory = <amt_gb_ram>, box="<base_box>", managed = <true|false>]
+  central_router [description = "central-router", address = "172.26.0.254"]
+  dns [description = "dns", address = "172.26.0.20"]
+  monitoring [description = "monitoring", address = "172.26.0.30", cpus = 2, memory = 2048]
+  web [description = "web", address = "172.26.0.10"]
+}
+
+
+network beta {
+  address = "172.26.10.0/24"
+
+  ' Note: hosts with multiple IP addresses (generally routers) are supported, but
+  ' the maximum is 3 IP addresses (not including the VirtualBox NAT interface)
+  ' due to technical constraints with VirtualBox. Any other unchanged variables
+  ' (like the description or cpu cores) do not have to be redefined.
+  central_router [address = "172.26.10.254"]
+}
+@endnwdiag
\ No newline at end of file
diff --git a/input/test_env/uml_test_env.puml b/input/test_env/uml_test_env.puml
new file mode 100644
index 0000000..2b7b7de
--- /dev/null
+++ b/input/test_env/uml_test_env.puml
@@ -0,0 +1,77 @@
+@startuml test_env
+' Specify diagram name above, otherwise falls back on filename for output directory
+' Note: this name must match with that of the network diagram
+
+' Fix roles being reused over different nodes
+' This line makes sure that objects with the same name (nota)
+set separator .
+' Purely visual, shouldn't have an effect on the parser
+left to right direction
+
+' Network definition
+'
+' Note: whatever comes after "as" is what's rendered by PlantUML
+'
+' Format: frame <network_identifier>
+frame alpha {
+    ' Host definition
+    '
+    ' Format: node <host_identifier> as <description> 
+    node dns as "dns" {
+        
+        ' Role definition
+        '
+        ' Format: component <role_identifier> as <role_name>
+        component bind_exporter
+        component dns_client
+        component dns_server
+        component node_exporter
+    }
+
+    node monitoring {
+        component dns_client
+        component grafana
+        component node_exporter
+        component prometheus
+    }
+
+    node web as "web" {
+        component dns_client
+        component mysqld_exporter
+        component node_exporter
+        component web_server
+    }
