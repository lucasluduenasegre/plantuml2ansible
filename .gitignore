# .gitignore

# Hidden Vagrant-directory
.vagrant

# Python development
.ropeproject

# Backup files (e.g. Vim, Gedit, etc.)
*~

# Compiled Python
*.pyc

# BATS installation
test/bats/

# Vagrant base boxes (you never know when someone puts one in the repository)
*.box

# Directories containing roles imported from Ansible Galaxy
# (user.role notation)
*/ansible/roles/*.*

# Ansible Retry-files
*.retry

# Ansible fact cache
.ansible_cache/

# Node.js build directory
node_modules/

# Converter output
output/*

# Private keys and certificates
*.key
*.pem
*.crt
*.p12
*.pfx

# Python virtual environments
venv/
env/
ENV/
.env/
.venv/

# Manual test environment
manual_test_env/*